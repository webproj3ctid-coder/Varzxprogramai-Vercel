{
  "cleanUrls": true,
  "rewrites": [
    {"source": "/vx-proxy/:path*", "destination": "http://lunaris-node-free.hostkita.help:20840/:path*"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"}]},
    {"source": "/(.*)\\.mp3", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]}
  ]
}
